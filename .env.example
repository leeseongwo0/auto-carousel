# Fixture commands require no environment variables.
NEWSBOT_DATABASE=
NEWSBOT_OUTPUT_DIR=

# Required by collect-live and reconcile-live. TELEGRAM_SESSION_PATH must name an existing
# owner-owned 0600 regular file in an owner-owned 0700 directory; symlinks are rejected.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=

# Required by notify-candidates, notify-review, and poll-approvals.
TELEGRAM_BOT_TOKEN=
NEWSBOT_APPROVER_CHAT_ID=
NEWSBOT_APPROVER_USER_IDS=

# Required by generate-pending or poll-approvals --process-generation with openai_compatible.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=
