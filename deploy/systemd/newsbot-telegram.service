[Unit]
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=newsbot
Group=newsbot
WorkingDirectory=/var/lib/newsbot-v2
EnvironmentFile=/etc/newsbot/newsbot.env
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ExecStart=/usr/local/bin/newsbot v2-telegram-tick --db /var/lib/newsbot-v2/newsbot-v2.sqlite --deadline 60 --timeout 10
TimeoutStartSec=75
TimeoutStopSec=10
KillMode=control-group
SendSIGKILL=yes
TasksMax=64
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
