[Unit]
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=newsbot
Group=newsbot
WorkingDirectory=/var/lib/newsbot-v2
EnvironmentFile=/etc/newsbot/newsbot.env
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ExecStart=/usr/local/bin/newsbot v2-collect-live --db /var/lib/newsbot-v2/newsbot-v2.sqlite --lookback-hours 24 --limit 100
TimeoutStartSec=210
TimeoutStopSec=10
KillMode=control-group
SendSIGKILL=yes
TasksMax=64
MemoryMax=4G
MemorySwapMax=0
CPUQuota=100%
